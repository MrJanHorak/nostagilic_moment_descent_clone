  "story": {
    "messages": [
      {
        "id": "vf:msg-start",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Same mine, second contract. The Consortium wants the foundry lift running so their 'recovery team' can follow you up. Climb, unlock extraction, get out. And keep an ear on that distress loop.",
        "trigger": {
          "on": "start"
        }
      },
      {
        "id": "vf:msg-foreman-closed",
        "speaker": "FOREMAN",
        "text": "NOTICE. FOUNDRY LEVELS ARE CLOSED. RETURN TO THE SURFACE.",
        "trigger": {
          "on": "enter",
          "roomId": "incline"
        }
      },
      {
        "id": "vf:msg-foreman-power",
        "speaker": "FOREMAN",
        "text": "LIFT POWER WITHDRAWN. THE CLIMB IS NOT SAFE FOR YOU.",
        "trigger": {
          "on": "enter",
          "roomId": "upper-works"
        }
      },
      {
        "id": "vf:msg-field",
        "speaker": "Vey · Kestrel dispatch",
        "text": "It's put a field across the lift. There's a control relay on this level; it can't hold that forever. Mind the floor, that's live lava.",
        "trigger": {
          "on": "enter",
          "roomId": "upper-works"
        }
      },
      {
        "id": "vf:msg-cache",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Distress loop is strongest in here. That scout is circling something. Someone, I think.",
        "trigger": {
          "on": "enter",
          "roomId": "coolant-cache"
        }
      },
      {
        "id": "vf:msg-foreman-worker",
        "speaker": "FOREMAN",
        "text": "THE WORKER IN THE COOLANT BAY IS UNHARMED. YOU MAY PROCEED.",
        "trigger": {
          "on": "defeat",
          "enemyId": "works-scout"
        }
      },
      {
        "id": "vf:msg-lift",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Field's down. Did that thing just give you permission? Climb before it changes its mind.",
        "trigger": {
          "on": "device",
          "deviceId": "relay-lift"
        }
      },
      {
        "id": "vf:msg-foreman-up",
        "speaker": "FOREMAN",
        "text": "IF YOU TAKE THEM, TAKE THEM UP. NOT DOWN.",
        "trigger": {
          "on": "enter",
          "roomId": "lift-control"
        }
      },
      {
        "id": "vf:msg-gate",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Extraction gate is open. 'Not down.' That memo said the lower works were being closed. I think FOREMAN read it too.",
        "trigger": {
          "on": "device",
          "deviceId": "relay-control"
        }
      }
    ],
    "logs": [
      {
        "id": "vf:log-ticket",
        "roomId": "upper-works",
        "position": [
          -6,
          0,
          -5
        ],
        "title": "Maintenance ticket 4471",
        "text": "FOREMAN cut lift power after Consortium recovery drones came up the incline. Reason logged: WORKER PROTECTION. Ticket reassigned to Consortium remote admin. Resolution: 'Override site AI. Restore access for recovery team.' Status: failed."
      },
      {
        "id": "vf:log-sato",
        "roomId": "lift-control",
        "position": [
          -5,
          0,
          -4
        ],
        "title": "Voice note: M. Sato",
        "text": "If the lift's dead we're stuck up here, but nothing comes up either. Ivo says FOREMAN sends a ration drop down the shaft every shift change. A mine computer, doing that. Nobody told it to."
      }
    ],
