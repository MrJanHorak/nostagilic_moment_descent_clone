  "story": {
    "messages": [
      {
        "id": "wi:msg-start",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Twenty-three people say the Consortium left them to die. Nobody off-world will believe a salvage crew. We need their own ledger. Admin block, records vault, then send it home through the executive uplink.",
        "trigger": {
          "on": "start"
        }
      },
      {
        "id": "wi:msg-records",
        "speaker": "FOREMAN",
        "text": "THE ARCHIVE IS SEALED BY CONSORTIUM ORDER. I DID NOT SEAL IT. I CAN STILL POWER IT.",
        "trigger": {
          "on": "enter",
          "roomId": "records-hall"
        }
      },
      {
        "id": "wi:msg-ledger",
        "speaker": "Vey · Kestrel dispatch",
        "text": "That's it. Closure costings, line by line. 'Personnel: not recovered.' Get it to the uplink.",
        "trigger": {
          "on": "device",
          "deviceId": "ledger-download"
        }
      },
      {
        "id": "wi:msg-suite",
        "speaker": "FOREMAN",
        "text": "THOSE MACHINES IN THE WALLS ARE NOT MINE. THE CONSORTIUM INSTALLED FABRICATORS. THEY WILL KEEP MAKING GUARDS UNTIL THEY RUN OUT.",
        "trigger": {
          "on": "enter",
          "roomId": "executive-suite"
        }
      },
      {
        "id": "wi:msg-uplink",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Uplink's live. The ledger is on Kestrel's servers and three news feeds. Whatever happens now, they can't bury it. Come home.",
        "trigger": {
          "on": "device",
          "deviceId": "uplink"
        }
      },
      {
        "id": "wi:msg-annex",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Someone's in the annex. Hana says her brother stayed behind to watch the dorms. He'll talk to us if we get him out.",
        "trigger": {
          "on": "enter",
          "roomId": "dorm-annex"
        }
      },
      {
        "id": "wi:msg-security",
        "speaker": "FOREMAN",
        "text": "SECURITY WING. ANOTHER FABRICATOR. YOU DO NOT NEED TO GO IN THERE. I KNOW YOU WILL ANYWAY.",
        "trigger": {
          "on": "enter",
          "roomId": "security-wing"
        }
      }
    ],
