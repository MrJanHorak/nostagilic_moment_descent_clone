  "story": {
    "messages": [
      {
        "id": "ts:msg-start",
        "speaker": "Vey · Kestrel dispatch",
        "text": "No contract this time, Two. Kestrel voted: we go back for the miners. FOREMAN opened the dock for us an hour ago. Get below the seal, find everyone you can, and bring them out on the evac lift.",
        "trigger": {
          "on": "start"
        }
      },
      {
        "id": "ts:msg-gallery",
        "speaker": "FOREMAN",
        "text": "WELCOME BACK, TWO. THE SHAFT FIELD IS MINE TO HOLD. THE PUMP HALL RELAY WILL RELEASE IT.",
        "trigger": {
          "on": "enter",
          "roomId": "shaft-gallery"
        }
      },
      {
        "id": "ts:msg-shaft",
        "speaker": "FOREMAN",
        "text": "SHAFT OPEN. THE LOWER WORKS ARE BELOW THE SEAL. I HAVE TOLD THEM YOU ARE COMING.",
        "trigger": {
          "on": "device",
          "deviceId": "shaft-power"
        }
      },
      {
        "id": "ts:msg-ante",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Those aren't FOREMAN's. Consortium Asset Protection is already down here. They must have come in on the deep freight line.",
        "trigger": {
          "on": "enter",
          "roomId": "seal-antechamber"
        }
      },
      {
        "id": "ts:msg-control",
        "speaker": "FOREMAN",
        "text": "THE SEAL HAS HELD FOR SEVENTEEN DAYS. RELEASING IT LETS THEM OUT. AND LETS THEM IN.",
        "trigger": {
          "on": "enter",
          "roomId": "seal-control"
        }
      },
      {
        "id": "ts:msg-seal",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Seal's open. The scrubber board said twenty-three people. Find who you can.",
        "trigger": {
          "on": "device",
          "deviceId": "seal-release"
        }
      },
      {
        "id": "ts:msg-dorms",
        "speaker": "Vey · Kestrel dispatch",
        "text": "This is where they've been living. Look at this place. Fly close to anyone you see; the hold has room.",
        "trigger": {
          "on": "enter",
          "roomId": "lower-dorms"
        }
      },
      {
        "id": "ts:msg-sump",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Careful in the sump. It's the lowest point in the works, so it floods first.",
        "trigger": {
          "on": "enter",
          "roomId": "flood-sump"
        }
      },
      {
        "id": "ts:msg-evac",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Evac lift control. Once it's powered the whole lift line lights up. If the Consortium is watching, they'll see it.",
        "trigger": {
          "on": "enter",
          "roomId": "evac-control"
        }
      },
      {
        "id": "ts:msg-destroyer",
        "speaker": "FOREMAN",
        "text": "THAT UNIT WAS ORDERED TO FLOOD THE LOWER WORKS. IT WILL NOT.",
        "trigger": {
          "on": "defeat",
          "enemyId": "asset-destroyer"
        }
      },
      {
        "id": "ts:msg-override",
        "speaker": "FOREMAN",
        "text": "WARNING. CONSORTIUM OVERRIDE RECEIVED. RESERVOIR RELEASE IN SEVENTY-FIVE SECONDS. I CANNOT STOP IT. GO.",
        "trigger": {
          "on": "device",
          "deviceId": "evac-power"
        }
      },
      {
        "id": "ts:msg-run",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Up the evac shaft, across the pump hall, back to the dock. Anyone aboard rides with you. Move!",
        "trigger": {
          "on": "device",
          "deviceId": "evac-power"
        }
      },
      {
        "id": "ts:msg-platform",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Lift top. Pump hall, gallery, dock. You know the way.",
        "trigger": {
          "on": "enter",
          "roomId": "evac-platform"
        }
      }
    ],
    "logs": [
      {
        "id": "ts:log-rollcall",
        "roomId": "survey-office",
        "position": [
          -4,
          0,
          -4
        ],
        "title": "Shelter roll call, day 15",
        "text": "Twenty-three in the lower dorms. Moved Pavel to the sump; it's warmer by the pumps. FOREMAN keeps the air on and drops rations at shift change. Hana is counting days on the bunk frame. Somebody please come."
      },
      {
        "id": "ts:log-seal",
        "roomId": "seal-control",
        "position": [
          -4,
          0,
          -4
        ],
        "title": "FOREMAN seal log",
        "text": "DAY 1: SEAL ENGAGED. REASON: CLOSURE ORDER AC-77. DAY 9: KESTREL PILOT EXTRACTED TWO WORKERS. DAY 12: CONSORTIUM OVERRIDE ATTEMPT 41 REJECTED. DAY 16: ASSET PROTECTION UNITS ENTERED VIA DEEP FREIGHT. DAY 17: TWO RETURNED."
      },
      {
        "id": "ts:log-orders",
        "roomId": "evac-control",
        "position": [
          4,
          0,
          4
        ],
        "title": "Asset Protection standing orders",
        "text": "Priority one: prevent unsanctioned egress from the lower works. If the evacuation lift is powered, release the reservoir. Contractor craft Kestrel-2 is to be treated as hostile. Do not engage the site AI directly."
      },
      {
        "id": "ts:log-locker",
        "roomId": "old-smelter",
        "position": [
          5,
          0,
          5
        ],
        "title": "Scratched into a locker door",
        "text": "If the lift lights up, they'll flood it. Get the young ones up first. Don't wait for me. — I. V."
      }
    ],
