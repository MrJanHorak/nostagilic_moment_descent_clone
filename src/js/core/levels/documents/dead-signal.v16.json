  "story": {
    "messages": [
      {
        "id": "ds:msg-start",
        "speaker": "Vey · Kestrel dispatch",
        "text": "We're home and we're deaf. The Consortium put jammers on both sides of the quay, so no rescue, no press, no lawyers. Kill both jammers together, power the old mast and get us back on air.",
        "trigger": {
          "on": "start"
        }
      },
      {
        "id": "ds:msg-foreman",
        "speaker": "FOREMAN",
        "text": "I AM IN YOUR CARGO BAY BETWEEN A CRATE OF RIVETS AND A COFFEE MACHINE. THE COFFEE MACHINE IS NOT INTELLIGENT. I HAVE CHECKED.",
        "trigger": {
          "on": "start"
        }
      },
      {
        "id": "ds:msg-west",
        "speaker": "FOREMAN",
        "text": "THE JAMMERS ARE PAIRED. KILL ONE ALONE AND THE OTHER RESTARTS IT. FIFTEEN SECONDS.",
        "trigger": {
          "on": "enter",
          "roomId": "west-jammer"
        }
      },
      {
        "id": "ds:msg-jammed",
