  "story": {
    "messages": [
      {
        "id": "df:msg-start",
        "speaker": "Vey · Kestrel dispatch",
        "text": "This is where Asset Protection got in: the deep freight line. Close it for good. The cranes lower the freight shaft, but only both at once. Someone take north, someone take south.",
        "trigger": {
          "on": "start"
        }
      },
      {
        "id": "df:msg-shaft",
        "speaker": "FOREMAN",
        "text": "SHAFT LOWERED. THE CARGO HOLD IS STILL THEIRS.",
        "trigger": {
          "on": "device",
          "deviceId": "crane-north"
        }
      },
      {
        "id": "df:msg-hold",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Two rail switches, west and east. Same trick: together, inside eight seconds. The switch room floor is slag, so mind your shields.",
        "trigger": {
          "on": "enter",
          "roomId": "cargo-hold"
        }
      },
      {
        "id": "df:msg-lock",
        "speaker": "FOREMAN",
        "text": "FREIGHT LOCK OPEN. THE DEEP LINE RUNS STRAIGHT TO THE CONSORTIUM YARD. I HAVE NEVER SEEN THE OTHER END.",
        "trigger": {
          "on": "device",
          "deviceId": "rail-west"
        }
      },
      {
        "id": "df:msg-line",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Line release is at the far end. Pull it and the whole line seals. Then the maintenance lift takes you straight up to the north crane.",
        "trigger": {
          "on": "enter",
          "roomId": "deep-line"
        }
      },
      {
        "id": "df:msg-release",
        "speaker": "FOREMAN",
        "text": "LINE SEALING. THE YARD WILL VENT THE TUNNEL IN NINETY SECONDS. THE LIFT IS OPEN. TAKE YOUR FRIENDS.",
        "trigger": {
          "on": "device",
          "deviceId": "line-release"
        }
      },
      {
        "id": "df:msg-destroyer",
        "speaker": "Vey · Kestrel dispatch",
        "text": "That was their heavy unit. They'll know we're here now.",
        "trigger": {
          "on": "defeat",
          "enemyId": "line-destroyer"
        }
      }
    ],
    "logs": [
      {
        "id": "df:log-manifest",
        "roomId": "cargo-hold",
        "position": [
          12,
          0,
          0
        ],
        "title": "Freight manifest AC-77-14",
        "text": "Cargo: 6 × Asset Protection units (fighter), 1 × heavy (destroyer), reservoir release charges. Destination: Asterion lower works. Authority: Closure Order AC-77. Note: site AI not to be informed."
      },
      {
        "id": "df:log-yard",
        "roomId": "deep-line",
        "position": [
          8,
          0,
          -10
        ],
        "title": "Yard dispatcher, private channel",
        "text": "If anyone asks, the line was never here. If the Kestrel pilots come through it, we seal the yard end and they can find their own way home."
      }
    ],
