  "story": {
    "messages": [
      {
        "id": "nr:msg-start",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Nightfall powers half the Ridge. The Consortium wants it shut down 'for safe recovery'. Clear the guards, open the coolant bypass, trigger shutdown, then you have sixty seconds to get back here.",
        "trigger": {
          "on": "start"
        }
      },
      {
        "id": "nr:msg-foreman-coolant",
        "speaker": "FOREMAN",
        "text": "THE COOLANT BYPASS IS LOCKED. THIS REACTOR KEEPS THE LOWER WORKS BREATHING.",
        "trigger": {
          "on": "enter",
          "roomId": "coolant-works"
        }
      },
      {
        "id": "nr:msg-bypass",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Bypass open. If that reactor runs the air below... hold on, Two. I'm asking the Consortium before you pull it.",
        "trigger": {
          "on": "device",
          "deviceId": "relay-coolant"
        }
      },
      {
        "id": "nr:msg-consortium",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Consortium says shut it down. Their exact words: 'Personnel matters are handled.' I don't like that sentence.",
        "trigger": {
          "on": "enter",
          "roomId": "reactor"
        }
      },
      {
        "id": "nr:msg-foreman-failsafe",
        "speaker": "FOREMAN",
        "text": "SHUTDOWN WILL START MY FAILSAFE. THE LOWER WORKS WILL SEAL ON BACKUP AIR. THEY WILL BE SAFE IN THE DARK.",
        "trigger": {
          "on": "enter",
          "roomId": "upper-control"
        }
      },
      {
        "id": "nr:msg-run",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Reactor's going critical and the failsafe is live. Sixty seconds. Drop through the floor hatch and run west. Go!",
        "trigger": {
          "on": "device",
          "deviceId": "relay-reactor"
        }
      },
      {
        "id": "nr:msg-foreman-thanks",
        "speaker": "FOREMAN",
        "text": "FAILSAFE ACTIVE. LOWER WORKS SEALED. THANK YOU, PILOT.",
        "trigger": {
          "on": "device",
          "deviceId": "relay-reactor"
        }
      },
      {
        "id": "nr:msg-reserve",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Another hidden cache. These miners have been planning for a long time.",
        "trigger": {
          "on": "enter",
          "roomId": "reserve-cache"
        }
      },
      {
        "id": "nr:msg-hale",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Someone up here wired that shutdown. If they're still aboard this rock, find them.",
        "trigger": {
          "on": "enter",
          "roomId": "upper-cache"
        }
      }
    ],
    "logs": [
      {
        "id": "nr:log-hale",
        "roomId": "upper-control",
        "position": [
          -6,
          0,
          -6
        ],
        "title": "Shift log: J. Hale",
        "text": "Day 6. Consortium remote-ordered a reactor shutdown. That kills the air below us. So I wired the shutdown into FOREMAN's seal failsafe: if anyone pulls it, the lower works seal and switch to backup scrubbers. I asked FOREMAN first. It agreed. It actually agreed."
      },
      {
        "id": "nr:log-scrubbers",
        "roomId": "coolant-works",
        "position": [
          -6,
          0,
          6
        ],
        "title": "Scrubber status board",
        "text": "Backup scrubbers, lower works: 14 days capacity at current load. Occupancy: 23. Last manual check: J. Hale. Consortium remote note attached: 'Do not count personnel against recovery budget.'"
      }
    ],
