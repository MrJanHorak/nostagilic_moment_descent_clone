  "story": {
    "messages": [
      {
        "id": "sb:msg-start",
        "speaker": "Vey · Kestrel dispatch",
        "text": "You're inside, Two. Asterion's Ridge relay has been dark for nine days and the Consortium wants its uplink back. Shoot the striped door, find the relay, get out. Easy money.",
        "trigger": {
          "on": "start"
        }
      },
      {
        "id": "sb:msg-foreman-seal",
        "speaker": "FOREMAN",
        "text": "NOTICE. THIS SECTION IS SEALED FOR WORKER SAFETY. UNAUTHORIZED CRAFT WILL BE REMOVED.",
        "trigger": {
          "on": "enter",
          "roomId": "entry-tunnel"
        }
      },
      {
        "id": "sb:msg-hall",
        "speaker": "Vey · Kestrel dispatch",
        "text": "That guard isn't on any Asterion manifest I have. It's flying security patterns, not mining ones. Use the doorway, or take the gallery overhead.",
        "trigger": {
          "on": "enter",
          "roomId": "signal-hall"
        }
      },
      {
        "id": "sb:msg-guard-down",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Guard's down. The uplink is right beside you. Bring it online.",
        "trigger": {
          "on": "defeat",
          "enemyId": "hall-fighter"
        }
      },
      {
        "id": "sb:msg-uplink",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Uplink's live, and the gate is open. Odd: the first thing it's relaying isn't telemetry. It's a distress loop from inside the mine. Sweep the side bays before you leave.",
        "trigger": {
          "on": "device",
          "deviceId": "relay-signal"
        }
      },
      {
        "id": "sb:msg-alcove",
        "speaker": "Vey · Kestrel dispatch",
        "text": "A hidden cache. Somebody stocked this on purpose. Asterion doesn't hide supplies from its own crews.",
        "trigger": {
          "on": "enter",
          "roomId": "repair-alcove"
        }
      },
      {
        "id": "sb:msg-foreman-workers",
        "speaker": "FOREMAN",
        "text": "WORKERS IN THIS SECTOR ARE SAFE. DO NOT REMOVE THEM.",
        "trigger": {
          "on": "enter",
          "roomId": "maintenance"
        }
      },
      {
        "id": "sb:msg-life-signs",
        "speaker": "Vey · Kestrel dispatch",
        "text": "I'm reading life signs. If anyone's down there, fly close and take them aboard. There's room in the hold, and they only count if you get them out.",
        "trigger": {
          "on": "enter",
          "roomId": "supply-bay"
        }
      },
      {
        "id": "sb:msg-extraction",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Gate's clear. Bring it home, Two. Then we talk about why a mining AI is guarding an empty relay.",
        "trigger": {
          "on": "enter",
          "roomId": "extraction"
        }
      }
    ],
    "logs": [
      {
        "id": "sb:log-okafor",
        "roomId": "repair-alcove",
        "position": [
          2,
          0,
          0
        ],
        "title": "Shift log: R. Okafor",
        "text": "Day 3 of the seal. FOREMAN dropped the bulkheads and says it's protecting us. From what? It won't say. We stocked this alcove with what we could carry. Dara's hiding in maintenance. If you're reading this, check the side bays."
      },
      {
        "id": "sb:log-memo",
        "roomId": "signal-hall",
        "position": [
          -6,
          0,
          5
        ],
        "title": "Consortium memo (fragment)",
        "text": "...Ridge output no longer justifies life-support spend. Recommend controlled closure of the lower works by end of quarter. Personnel status to be handled by site automation. Do not route this through the public relay."
      }
    ],
