  "story": {
    "messages": [
      {
        "id": "by:msg-start",
        "speaker": "Vey · Kestrel dispatch",
        "text": "The broadcast worked; everyone heard. Including the Consortium. Their forward depot's in the old breaker yard and it's building something big. Open the floor, take it down, and break the console so it can't follow us.",
        "trigger": {
          "on": "start"
        }
      },
      {
        "id": "by:msg-west",
        "speaker": "FOREMAN",
        "text": "THEY CALL IT THE WARDEN. IT WAS DESIGNED TO RECOVER ME. IT IS ARMOURED EVERYWHERE, NOT ONLY IN FRONT. IT WILL CALL FOR HELP WHEN IT IS HURT. SO DID I, ONCE.",
        "trigger": {
          "on": "enter",
          "roomId": "west-yard"
        }
      },
      {
        "id": "by:msg-depot",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Depot's full of recovery cradles. One of them is FOREMAN-sized. They really were coming to take it back.",
        "trigger": {
          "on": "enter",
          "roomId": "consortium-depot"
        }
      },
      {
        "id": "by:msg-floor",
        "speaker": "FOREMAN",
        "text": "THE WARDEN. DO NOT STAY STILL. EACH TIME ITS SHIELDS FALL A THIRD IT FIGHTS HARDER AND CALLS ESCORTS.",
        "trigger": {
          "on": "enter",
          "roomId": "breaker-floor"
        }
      },
      {
        "id": "by:msg-console",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Console's cooking. The floor's going to fold into the scrap line. Ninety seconds: drop, run the tunnel, take the lift up to the gatehouse.",
        "trigger": {
          "on": "device",
          "deviceId": "breaker-console"
        }
      },
      {
        "id": "by:msg-scrap",
        "speaker": "FOREMAN",
        "text": "THE SCRAP LINE IS MOLTEN. FLY HIGH. I WOULD LIKE TO KEEP MY PILOT.",
        "trigger": {
          "on": "enter",
          "roomId": "scrap-line"
        }
      },
      {
        "id": "by:msg-tunnel",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Tunnel's clear. Lift's dead ahead. Go.",
        "trigger": {
          "on": "enter",
          "roomId": "scrap-tunnel"
        }
      }
    ],
