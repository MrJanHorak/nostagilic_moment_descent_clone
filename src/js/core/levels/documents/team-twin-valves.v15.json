  "story": {
    "messages": [
      {
        "id": "tv:msg-start",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Side job while the Seal survivors recover: Asterion's west pump station is leaking pressure into the lower works. The core only vents if both valves turn together. Split up: one of you west, one east.",
        "trigger": {
          "on": "start"
        }
      },
      {
        "id": "tv:msg-west",
        "speaker": "FOREMAN",
        "text": "WEST VALVE. IT WILL HOLD FOR TEN SECONDS. THE EAST VALVE MUST TURN BEFORE IT LETS GO.",
        "trigger": {
          "on": "enter",
          "roomId": "west-valve-room"
        }
      },
      {
        "id": "tv:msg-east",
        "speaker": "FOREMAN",
        "text": "EAST VALVE. THE CONSORTIUM BUILT THIS STATION SO NO ONE PILOT COULD OPEN IT. THEY DID NOT EXPECT FRIENDS.",
        "trigger": {
          "on": "enter",
          "roomId": "east-valve-room"
        }
      },
      {
        "id": "tv:msg-linked",
        "speaker": "Vey · Kestrel dispatch",
        "text": "Both valves are open, and so are the core lines. Meet in the middle.",
        "trigger": {
          "on": "device",
          "deviceId": "east-valve"
        }
      },
      {
        "id": "tv:msg-core",
        "speaker": "Vey · Kestrel dispatch",
        "text": "That's a destroyer in the pressure core. Take it down together, then pull the release.",
        "trigger": {
          "on": "enter",
          "roomId": "pressure-core"
        }
      },
      {
        "id": "tv:msg-release",
        "speaker": "FOREMAN",
        "text": "PRESSURE VENTING. THE CORE WILL FLOOD WITH STEAM IN SIXTY SECONDS. THE RETURN LINE IS OPEN. GO HOME.",
        "trigger": {
          "on": "device",
          "deviceId": "core-release"
        }
      }
    ],
    "logs": [
      {
        "id": "tv:log-design",
        "roomId": "west-pumphouse",
        "position": [
          6,
          0,
          6
        ],
        "title": "Station design note",
        "text": "Two-valve interlock per Consortium safety standard 12: no single operator may vent the core. Valves must be turned within ten seconds of each other. Lone technicians: request a partner or don't touch it."
      },
      {
        "id": "tv:log-shift",
        "roomId": "east-valve-room",
        "position": [
          6,
          0,
          6
        ],
        "title": "Shift note",
        "text": "Mara's on west, I'm on east, radio check every five minutes. If FOREMAN shuts the station again we turn them together and walk out through the core. — D."
      }
    ],
    "survivors": [
