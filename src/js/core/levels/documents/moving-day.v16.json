  "story": {
    "messages": [
      {
        "id": "md:msg-start",
        "speaker": "FOREMAN",
        "text": "TWO. THE CONSORTIUM HAS ORDERED A HARD OVERRIDE OF MY CORE. IT ARRIVES IN THE OLD VAULT TONIGHT. I WOULD LIKE TO NOT BE THERE. WILL YOU HELP ME MOVE?",
        "trigger": {
          "on": "start"
        }
      },
      {
        "id": "md:msg-vey",
        "speaker": "Vey · Kestrel dispatch",
        "text": "First time anyone's asked Kestrel for a favour instead of a quote. Both transfer stations hand the core over together, then the cradle, then the old lift. Let's move a house.",
        "trigger": {
          "on": "start"
        }
      },
      {
        "id": "md:msg-west",
