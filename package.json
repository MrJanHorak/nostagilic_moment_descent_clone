    "node": "^22.14.0 || ^24.0.0",
    "npm": ">=11.2.0 <12"
  },
  "scripts": {
    "test": "node --test tests/startup.test.mjs tests/session.test.mjs tests/flight.test.mjs tests/arena.test.mjs tests/combat.test.mjs tests/metrics.test.mjs tests/settings.test.mjs",
